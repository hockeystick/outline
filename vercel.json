{
  "version": 2,
  "buildCommand": "yarn install --frozen-lockfile && yarn build",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  },
  "build": {
    "env": {
      "NODE_ENV": "production",
      "VITE_CJS_IGNORE_WARNING": "true"
    }
  },
  "functions": {
    "api/index.js": {
      "memory": 3008,
      "maxDuration": 300,
      "includeFiles": "build/**"
    }
  }
}
